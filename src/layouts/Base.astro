---
import '../styles/global.css';

interface Props {
  title?: string;
  section?: 'frases' | 'ensaios' | 'sobre';
}
const { title = 'Caderno', section } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="brand">
          <a class="wordmark" href="/">Caderno</a>
          <span class="tagline">um caderno de leituras</span>
        </div>
        <nav>
          <a href="/" class={section === 'frases' ? 'active' : ''}>Frases</a>
          <a href="/ensaios/" class={section === 'ensaios' ? 'active' : ''}>Ensaios</a>
          <a href="/sobre/" class={section === 'sobre' ? 'active' : ''}>Sobre</a>
        </nav>
        <hr class="rule" />
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <span>Caderno</span>
        <span>desde 2026</span>
      </footer>
    </div>
  </body>
</html>
