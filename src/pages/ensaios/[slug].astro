---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const ensaios = await getCollection('ensaios');
  return ensaios.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} — Caderno`} section="ensaios">
  <a class="back" href="/ensaios/">← Ensaios</a>
  <article class="essay">
    <span class="eyebrow">Ensaio</span>
    <h1>{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
