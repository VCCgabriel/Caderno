---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const ensaios = (await getCollection('ensaios'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Ensaios — Caderno" section="ensaios">
  <p class="lede">
    De vez em quando, um texto mais longo — sobre um livro, uma série, uma
    música, ou sobre uma frase que não sai da cabeça.
  </p>
  {
    ensaios.map((e) => (
      <a class="post-link" href={`/ensaios/${e.slug}/`}>
        <span class="eyebrow">Ensaio</span>
        <h2>{e.data.title}</h2>
        {e.data.summary ? <p class="dek">{e.data.summary}</p> : null}
      </a>
    ))
  }
</Base>
